<div class="pts-root">
  <div class="form-group">
    <label>Tags (comma-separated)</label>
    <input type="text" name="tags" placeholder="shop, weapon">
  </div>

  <div class="form-group">
    <label>Match</label>
    <label><input type="radio" name="match" value="all" checked> All tags (AND)</label>
    <label><input type="radio" name="match" value="any"> Any tag (OR)</label>
  </div>

  <div class="form-group">
    <label>Targets</label>
    <label><input type="radio" name="targets" value="notes"> Notes</label>
    <label><input type="radio" name="targets" value="regions"> Regions</label>
    <label><input type="radio" name="targets" value="both" checked> Both</label>
  </div>

  <div class="form-group">
    <label>Display</label>
    <label><input type="radio" name="mode" value="map" checked> Show on map</label>
    <label><input type="radio" name="mode" value="list"> List view</label>
  </div>

  <div class="form-group">
    <label>Audience</label>
    <label><input type="radio" name="audience" value="me" checked> Only me</label>
    <label><input type="radio" name="audience" value="everyone"> Everyone</label>
  </div>


  <div class="buttons">
    <button type="button" data-action="search">
      <i class="fa-solid fa-magnifying-glass"></i> Search
    </button>
    <button type="button" data-action="clear">
      <i class="fa-solid fa-xmark"></i> Clear
    </button>
  </div>
</div>
