<section class="pts-results">
  <h3>{{title}}</h3>

  {{#if notes.length}}
    <h4>Notes</h4>
    <ol class="pts-list">
      {{#each notes}}
        <li>
          <button type="button" data-action="pan" data-type="{{type}}" data-id="{{id}}">
            {{name}}
          </button>
        </li>
      {{/each}}
    </ol>
  {{/if}}

  {{#if regions.length}}
    <h4>Regions</h4>
    <ol class="pts-list">
      {{#each regions}}
        <li>
          <button type="button" data-action="pan" data-type="{{type}}" data-id="{{id}}">
            {{name}}
          </button>
        </li>
      {{/each}}
    </ol>
  {{/if}}

  {{#unless notes.length}}
    {{#unless regions.length}}
      <p><em>No matching POIs in this scene.</em></p>
    {{/unless}}
  {{/unless}}
</section>
